# -----------------------------------------------------------------------------
# Copy to terraform.tfvars and adjust for your environment
# -----------------------------------------------------------------------------

# General
project_name   = "eks-blueprint"
environment    = "prod"
region         = "us-east-1"
aws_account_id = "123456789012"

tags = {
  Environment = "prod"
  ManagedBy   = "Terraform"
  Project     = "EKS-Blueprint"
}

# VPC
vpc_cidr             = "10.0.0.0/16"
availability_zones   = ["us-east-1a", "us-east-1b", "us-east-1c"]
public_subnet_cidrs  = ["10.0.1.0/24", "10.0.2.0/24", "10.0.3.0/24"]
private_subnet_cidrs = ["10.0.11.0/24", "10.0.12.0/24", "10.0.13.0/24"]
enable_nat_gateway   = true
single_nat_gateway   = true   # true = 1 NAT (barato), false = 1 NAT por AZ (HA)
enable_vpn_gateway   = false

# Secondary Network
secondary_cidr          = "10.147.0.0/16"
enable_secondary_network = false

# EKS Cluster
cluster_version                  = "1.34"
cluster_endpoint_private_access  = true
cluster_endpoint_public_access   = false
cluster_endpoint_public_access_cidrs = [] # Or your VPN/runner IPv4 CIDR with public access enabled.
enable_cluster_autoscaling       = false
enable_managed_node_group        = false

# Karpenter
enable_karpenter     = true
karpenter_namespace  = "karpenter"
karpenter_on_fargate = true
karpenter_version    = "1.9.0"

# ArgoCD
enable_argocd    = true
argocd_namespace = "argocd"
argocd_version   = "6.0.0"

# Gateway API
enable_gateway_api  = true
gateway_api_version = "1.2.0"

# Add-ons
enable_vpc_cni        = true
enable_ebs_csi        = true
enable_efs_csi        = false
enable_coredns        = true
enable_kube_proxy     = true
enable_metrics_server = true

# Node Storage
node_volume_type       = "gp3"
node_volume_size       = 100
node_volume_iops       = 3000
node_volume_throughput = 125
enable_ebs_encryption  = true
ebs_kms_key_id = null # Create a dedicated key.

# IAM Identity Center (optional)
enable_iam_identity_center = false
sso_principal_arn = null

# GitHub OIDC is optional; set explicit managed policies before enabling.
enable_github_actions_oidc = false
github_environment = "prod"
github_deploy_policy_arns = []
